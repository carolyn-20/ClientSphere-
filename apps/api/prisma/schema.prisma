generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  SALES
  MARKETING
  SUPPORT
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  UNQUALIFIED
  CONVERTED
}

enum OpportunityStage {
  PROSPECTING
  QUALIFICATION
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum ActivityType {
  CALL
  EMAIL
  MEETING
  TASK
  NOTE
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String
  role         Role       @default(SALES)
  createdAt    DateTime   @default(now())
  leads        Lead[]     @relation("LeadOwner")
  activities   Activity[]
}

model Company {
  id            String        @id @default(cuid())
  name          String
  website       String?
  industry      String?
  createdAt     DateTime      @default(now())
  contacts      ContactCompany[]
  opportunities Opportunity[]
}

model Contact {
  id         String           @id @default(cuid())
  firstName  String
  lastName   String
  email      String?
  phone      String?
  title      String?
  createdAt  DateTime         @default(now())
  companies  ContactCompany[]
  activities Activity[]
}

model ContactCompany {
  contactId         String
  companyId         String
  relationshipTitle String?
  contact           Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  company           Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([contactId, companyId])
}

model Lead {
  id        String     @id @default(cuid())
  firstName String
  lastName  String
  email     String     @unique
  phone     String?
  source    String?
  status    LeadStatus @default(NEW)
  score     Int        @default(0)
  ownerId   String?
  owner     User?      @relation("LeadOwner", fields: [ownerId], references: [id])
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([status, ownerId])
}

model Opportunity {
  id            String           @id @default(cuid())
  name          String
  amount        Decimal          @db.Decimal(12, 2)
  probability   Int              @default(20)
  stage         OpportunityStage @default(PROSPECTING)
  expectedClose DateTime?
  companyId     String?
  company       Company?         @relation(fields: [companyId], references: [id])
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([stage, expectedClose])
}

model Activity {
  id          String       @id @default(cuid())
  type        ActivityType
  subject     String
  description String?
  dueAt       DateTime?
  completed   Boolean      @default(false)
  userId      String?
  user        User?        @relation(fields: [userId], references: [id])
  contactId   String?
  contact     Contact?     @relation(fields: [contactId], references: [id])
  createdAt   DateTime     @default(now())
}

model Workflow {
  id        String   @id @default(cuid())
  name      String
  trigger   String
  condition String
  action    String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  entity    String
  entityId  String
  action    String
  metadata  Json?
  createdAt DateTime @default(now())
}
